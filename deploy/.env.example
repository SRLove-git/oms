MYSQL_ROOT_PASSWORD=root123456
MYSQL_PASSWORD=oms123456

# J&T Express Singapore production API. Copy to deploy/.env on the server;
# never commit real credentials or the webhook secret.
# OMS_JTEXPRESS_ENABLED=true requires a non-empty OMS_JTEXPRESS_WEBHOOK_SECRET.
OMS_JTEXPRESS_ENABLED=false
OMS_JTEXPRESS_BASE_URL=https://edishops.jtexpress.sg/jts-service-doorstep
OMS_JTEXPRESS_EMAIL=
OMS_JTEXPRESS_PASSWORD=
OMS_JTEXPRESS_MERCHANT_CODE=C0314
OMS_JTEXPRESS_SERVICE_CODE=DOM123
OMS_JTEXPRESS_WEBHOOK_SECRET=
OMS_INTERNAL_SERVICE_SECRET=change-this-internal-service-secret

# Shared HMAC secret for OMS -> storefront callbacks. The same value must be
# configured as BUZUD_OMS_CALLBACK_SECRET in the storefront backend.
OMS_MALL_CALLBACK_SECRET=
